{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build OpenGL Project",
            "type": "shell",
            "command": "g++",
            "args": [
                "-g",
                "${workspaceFolder}/src/*.cpp",
                "${workspaceFolder}/src/core/*.cpp",
                "${workspaceFolder}/src/glad.c",
                "-I${workspaceFolder}/include",
                "-I${workspaceFolder}/src",
                "-I${workspaceFolder}/vcpkg/installed/x64-mingw-dynamic/include",
                "-L${workspaceFolder}/lib",
                "-L${workspaceFolder}/vcpkg/installed/x64-mingw-dynamic/lib",
                "-lglfw3dll",
                "-lassimp",
                "-lopengl32",
                "-lgdi32",
                "-o",
                "${workspaceFolder}/main.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PATH": "${workspaceFolder}/vcpkg/installed/x64-mingw-dynamic/bin;${env:PATH}"
                }
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Compiler task for full OpenGL Project"
        }
    ]
}